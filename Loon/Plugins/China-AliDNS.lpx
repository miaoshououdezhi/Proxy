#!name = China-AliDNS 国内应用分类解析
#!desc = 国内常用应用使用阿里云 DoH (dns.alidns.com)；其他域名使用 Loon 主配置 DNS。
#!homepage = https://github.com/o-ocn/loon-rules
#!icon = https://github.com/miaoshououdezhi/Proxy/blob/main/Loon/Logo/Speedtest.png
#!date = 2026-11-08
# 依据用户上传的完整 Host 清单重新分类：282 条去重映射，29 个分类。
# 所有映射统一使用 https://dns.alidns.com/dns-query 。
# 注意：这是 DNS 解析映射，不改变代理分流策略；部分历史域名请以实际日志为准。

[Host]

# ==============================================================
# 01 | 中国大陆域名（通用）（1 条）
# ==============================================================
# *.cn 为 .cn 子域名提供通用阿里云 DoH 解析；下面仍保留部分明确的 .cn 业务规则。
*.cn = server:https://dns.alidns.com/dns-query

# ==============================================================
# 02 | Apple App Store / CDN（仅指定域名）（13 条）
# ==============================================================
# 仅对列出的 Apple 主机和 CDN 生效；不使用 *.apple.com 或 *.icloud.com。
# 包含全球共用的 apps.apple.com，可能影响外区 App Store 的 CDN 选择。
amp-api-edge.apps.apple.com = server:https://dns.alidns.com/dns-query
amp-api-search-edge.apps.apple.com = server:https://dns.alidns.com/dns-query
amp-api.apps.apple.com = server:https://dns.alidns.com/dns-query
apps.apple.com = server:https://dns.alidns.com/dns-query
cl1.apple.com = server:https://dns.alidns.com/dns-query
cl2.apple.com = server:https://dns.alidns.com/dns-query
cl3.apple.com = server:https://dns.alidns.com/dns-query
cl4.apple.com = server:https://dns.alidns.com/dns-query
cl5.apple.com = server:https://dns.alidns.com/dns-query
guzzoni.smoot.apple.com = server:https://dns.alidns.com/dns-query
*.mzstatic.com = server:https://dns.alidns.com/dns-query
pancake.apple.com = server:https://dns.alidns.com/dns-query
tr.iadsdk.apple.com = server:https://dns.alidns.com/dns-query

# ==============================================================
# 03 | 阿里巴巴 / 淘宝 / 支付宝 / 闲鱼 / 盒马（12 条）
# ==============================================================
